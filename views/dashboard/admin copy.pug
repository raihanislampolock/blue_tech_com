<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Blue Tech Command Center - Admin Panel & Pug Generator</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    script.
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'sans-serif'] },
                    colors: {
                        brand: {
                            blue: '#3c8dbc',
                            dark: '#2c3e50',
                            accent: '#00c0ef',
                            bg: '#f4f6f9'
                        }
                    }
                }
            }
        }

    style.
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f4f6f9;
        }

        /* Tech Grid Background pattern from your style */
        .tech-grid-bg {
            background-image: 
                radial-gradient(#3c8dbc2a 1px, transparent 1px), 
                radial-gradient(#3c8dbc2a 1px, transparent 1px);
            background-size: 20px 20px;
            background-position: 0 0, 10px 10px;
        }

        /* Neon Box hover physics */
        .neon-box {
            background: rgba(255, 255, 255, 0.95) !important;
            backdrop-filter: blur(8px);
            border: 1px solid rgba(60, 141, 188, 0.12);
            border-radius: 12px !important;
            overflow: hidden;
            box-shadow: 0 10px 25px -5px rgba(44, 62, 80, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.01) !important;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
        }

        .neon-box:hover {
            transform: translateY(-6px) scale(1.015);
            box-shadow: 0 20px 35px -10px rgba(60, 141, 188, 0.25) !important;
            border-color: rgba(60, 141, 188, 0.3);
        }

        .info-box-icon {
            transition: all 0.4s ease;
            display: flex !important;
            align-items: center;
            justify-content: center;
        }

        .neon-box:hover .info-box-icon {
            filter: brightness(1.25) drop-shadow(0 0 8px rgba(255, 255, 255, 0.3));
        }

        .info-box-content {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* Custom scrollbars */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #1e293b;
        }
        ::-webkit-scrollbar-thumb {
            background: #334155;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #475569;
        }
</head>
