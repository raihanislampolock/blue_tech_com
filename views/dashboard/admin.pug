extends ../layout

block style
  style.
    /* Subtle Tech Grid Background */
    section.content {
      background-image: 
        radial-gradient(#3c8dbc1a 1px, transparent 1px), 
        radial-gradient(#3c8dbc1a 1px, transparent 1px);
      background-size: 20px 20px;
      background-position: 0 0, 10px 10px;
      min-height: 100vh;
    }

    .neon-box {
      background: rgba(255, 255, 255, 0.9) !important;
      backdrop-filter: blur(5px); /* Modern Glassmorphism */
      border: 1px solid rgba(0, 0, 0, 0.05);
      border-radius: 12px !important;
      overflow: hidden;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08) !important;
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s ease !important;
    }

    .neon-box:hover {
      transform: translateY(-5px) scale(1.01);
      box-shadow: 0 15px 35px rgba(60, 141, 188, 0.2) !important;
    }

    .info-box-icon {
      transition: all 0.4s ease;
      display: flex !important;
      align-items: center;
      justify-content: center;
    }

    .neon-box:hover .info-box-icon {
      filter: brightness(1.2);
    }
    
    /* Clean text containment overrides */
    .info-box-content {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

include ../partials/dashboard-selector

block content
  section.content-header
    h1
      | SuperAdmin Dashboard
    ol.breadcrumb
