            .info-box-content
              span.info-box-text(style="color: #2c3e50; font-size: 16px; font-weight: 700;") Blue Tech Payment Methods
              span.info-box-number(style="font-size: 12px; font-weight: 400; color: #7f8c8d;") Types of Payment
              .progress
                .progress-bar(style='width: 100%; background: #3c8dbc;')  

    .row
      .col-md-12
        .box.box-parrot
          .box-header
            h3.box-title Quick Link Button for Billing Management      

      .col-lg-4.col-md-6.col-sm-6.col-xs-12
        a(href='/bluetech/bluetech-purchase' style='text-decoration:none;')
