extends ../../layout

block style
  style.
    .flow-report { --ink: #172033; --muted: #718096; --line: #e6eaf0; --blue: #2563eb; --green: #059669; --amber: #d97706; --rose: #dc2626; }
    .flow-report .report-heading { display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; margin-bottom: 20px; }
    .flow-report .report-title { color: var(--ink); font-size: 26px; font-weight: 700; margin: 0 0 6px; }
    .flow-report .report-subtitle { color: var(--muted); margin: 0; }
    .flow-report .year-control { display: flex; align-items: center; gap: 8px; color: var(--muted); font-weight: 600; padding-top: 30px; }
    .flow-report .year-control select { width: 100px; border: 1px solid #cfd6e2; border-radius: 4px; }
    .flow-report .metric-card { border: 1px solid var(--line); border-top: 3px solid var(--accent); border-radius: 5px; background: #fff; min-height: 125px; padding: 18px; box-shadow: 0 3px 12px rgba(23,32,51,.04); }
    .flow-report .metric-label { color: var(--muted); font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; }
    .flow-report .metric-value { color: var(--ink); font-size: 25px; font-weight: 700; margin-top: 12px; }
    .flow-report .metric-meta { color: var(--muted); font-size: 12px; margin-top: 4px; }
    .flow-report .report-panel { background: #fff; border: 1px solid var(--line); border-radius: 5px; box-shadow: 0 3px 12px rgba(23,32,51,.04); }
    .flow-report .panel-heading { border-bottom: 1px solid var(--line); padding: 16px 18px; }
    .flow-report .panel-heading h3 { color: var(--ink); font-size: 16px; font-weight: 700; margin: 0; }
    .flow-report .panel-heading p { color: var(--muted); font-size: 12px; margin: 5px 0 0; }
    .flow-report .table { margin: 0; }
    .flow-report .table th { background: #f7f9fc; color: #536174; font-size: 11px; text-transform: uppercase; letter-spacing: .35px; white-space: nowrap; }
    .flow-report .table td, .flow-report .table th { border-color: var(--line); padding: 11px 12px; vertical-align: middle; }
    .flow-report .number { text-align: right; white-space: nowrap; }
    .flow-report .positive { color: var(--green); font-weight: 700; }
    .flow-report .negative { color: var(--rose); font-weight: 700; }
    .flow-report .empty-state { color: var(--muted); padding: 35px !important; text-align: center; }
    .flow-report .loading { color: var(--muted); padding: 30px !important; text-align: center; }
    @media (max-width: 767px) { .flow-report .report-heading { display: block; } .flow-report .year-control { margin-top: 15px; } .flow-report .table-responsive { border: 0; } }

block content
  section.content-header
    ol.breadcrumb
      li
        a(href='/dashboard') Dashboard
      li Blue Tech Solutions
      li Inventory Flow & Sales Performance
  section.content.flow-report
    .report-heading
      div
        h1.report-title Inventory Flow & Sales Performance
        p.report-subtitle Monthly ordered, purchased, and sold performance for the selected year.
      label.year-control(for='yearSelect')
        | Reporting year
        select.form-control#yearSelect
    .row#metricCards
      .col-md-3.col-sm-6
        .metric-card(style='--accent: #2563eb')
          .metric-label Ordered
          .metric-value#orderedMetric 0
          .metric-meta#orderedValue ৳0.00 committed value
      .col-md-3.col-sm-6
        .metric-card(style='--accent: #d97706')
          .metric-label Purchased
          .metric-value#purchasedMetric 0
          .metric-meta#purchasedValue ৳0.00 purchase value
      .col-md-3.col-sm-6
        .metric-card(style='--accent: #059669')
          .metric-label Sold
          .metric-value#soldMetric 0
          .metric-meta#soldValue ৳0.00 sales value
      .col-md-3.col-sm-6
        .metric-card(style='--accent: #7c3aed')
          .metric-label Gross margin
          .metric-value#marginMetric ৳0.00
          .metric-meta#stockMetric 0 units net stock movement
    .row
      .col-md-12
        .report-panel
          .panel-heading
            h3 Monthly performance
            p Compare quantities and values across the full year. Zero-activity months remain visible.
          .table-responsive
            table.table.table-hover
              thead
                tr
                  th Month
                  th.number Ordered qty
                  th.number Ordered value
                  th.number Purchased qty
                  th.number Purchase value
                  th.number Sold qty
                  th.number Sales value
                  th.number Net stock
                  th.number Gross margin
              tbody#monthlyBody
                tr
                  td.loading(colspan='9') Loading report...
    .row(style='margin-top: 20px;')
      .col-md-12
        .report-panel
          .panel-heading
            h3 Item performance
            p Items are ranked by sales value for the selected year.
          .table-responsive
            table.table.table-hover
              thead
                tr
                  th Item
                  th.number Ordered qty
                  th.number Purchased qty
                  th.number Sold qty
                  th.number Purchase value
                  th.number Sales value
                  th.number Net stock
                  th.number Gross margin
              tbody#itemBody
                tr
                  td.loading(colspan='8') Loading report...

block script
  script.
    document.addEventListener('DOMContentLoaded', function () {
      const yearSelect = document.getElementById('yearSelect');
      const currentYear = new Date().getFullYear();
      for (let year = currentYear; year >= currentYear - 4; year -= 1) {
        const option = document.createElement('option');
        option.value = year;
        option.textContent = year;
        yearSelect.appendChild(option);
      }
      yearSelect.value = currentYear;

      const money = value => '৳' + Number(value || 0).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      const qty = value => Number(value || 0).toLocaleString(undefined, { maximumFractionDigits: 2 });
      const signedClass = value => Number(value || 0) < 0 ? 'negative' : 'positive';

      function render(data) {
        const totals = data.monthly.reduce((result, row) => {
          ['orderedQty', 'orderedValue', 'purchasedQty', 'purchasedValue', 'soldQty', 'soldValue', 'netStockQty', 'grossMargin'].forEach(key => result[key] += Number(row[key] || 0));
          return result;
        }, { orderedQty: 0, orderedValue: 0, purchasedQty: 0, purchasedValue: 0, soldQty: 0, soldValue: 0, netStockQty: 0, grossMargin: 0 });
        document.getElementById('orderedMetric').textContent = qty(totals.orderedQty);
        document.getElementById('orderedValue').textContent = money(totals.orderedValue) + ' committed value';
        document.getElementById('purchasedMetric').textContent = qty(totals.purchasedQty);
        document.getElementById('purchasedValue').textContent = money(totals.purchasedValue) + ' purchase value';
        document.getElementById('soldMetric').textContent = qty(totals.soldQty);
        document.getElementById('soldValue').textContent = money(totals.soldValue) + ' sales value';
        document.getElementById('marginMetric').textContent = money(totals.grossMargin);
        document.getElementById('marginMetric').className = 'metric-value ' + signedClass(totals.grossMargin);
        document.getElementById('stockMetric').textContent = qty(totals.netStockQty) + ' units net stock movement';

        document.getElementById('monthlyBody').innerHTML = data.monthly.map(row => '<tr>' +
          '<td><strong>' + row.monthName + '</strong></td>' +
          '<td class="number">' + qty(row.orderedQty) + '</td><td class="number">' + money(row.orderedValue) + '</td>' +
          '<td class="number">' + qty(row.purchasedQty) + '</td><td class="number">' + money(row.purchasedValue) + '</td>' +
          '<td class="number">' + qty(row.soldQty) + '</td><td class="number">' + money(row.soldValue) + '</td>' +
          '<td class="number ' + signedClass(row.netStockQty) + '">' + qty(row.netStockQty) + '</td>' +
          '<td class="number ' + signedClass(row.grossMargin) + '">' + money(row.grossMargin) + '</td></tr>').join('');

        document.getElementById('itemBody').innerHTML = data.itemSummary.length ? data.itemSummary.map(row => '<tr>' +
          '<td><strong>' + row.itemName + '</strong></td><td class="number">' + qty(row.orderedQty) + '</td>' +
          '<td class="number">' + qty(row.purchasedQty) + '</td><td class="number">' + qty(row.soldQty) + '</td>' +
          '<td class="number">' + money(row.purchasedValue) + '</td><td class="number">' + money(row.soldValue) + '</td>' +
          '<td class="number ' + signedClass(row.netStockQty) + '">' + qty(row.netStockQty) + '</td>' +
          '<td class="number ' + signedClass(row.grossMargin) + '">' + money(row.grossMargin) + '</td></tr>').join('') : '<tr><td class="empty-state" colspan="8">No inventory activity recorded for this year.</td></tr>';
      }

      async function loadReport() {
        document.getElementById('monthlyBody').innerHTML = '<tr><td class="loading" colspan="9">Loading report...</td></tr>';
        try {
          const response = await fetch('/api/bluetech/inventory-flow-report?year=' + yearSelect.value);
          const result = await response.json();
          if (!result.status) throw new Error(result.message || 'Report could not be loaded');
          render(result.data);
        } catch (error) {
          document.getElementById('monthlyBody').innerHTML = '<tr><td class="empty-state" colspan="9">' + error.message + '</td></tr>';
          document.getElementById('itemBody').innerHTML = '';
        }
      }
      yearSelect.addEventListener('change', loadReport);
      loadReport();
    });